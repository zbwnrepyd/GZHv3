{
  "version": "v3",
  "description": "字段契约 — 定义系统中所有可用字段的类型、分组和约束。字段不天然属于任何卡片。支持 v1/v2/v3 三套卡。",
  "groups": [
    {
      "group_key": "basic",
      "group_label": "基础信息",
      "fields": [
        {"field_key": "company_name", "field_label": "公司名", "type": "text", "required": true},
        {"field_key": "company_type", "field_label": "公司类型", "type": "text", "required": false},
        {"field_key": "company_def", "field_label": "公司定义", "type": "long_text", "required": true},
        {"field_key": "location", "field_label": "地理位置", "type": "text", "required": false},
        {"field_key": "website_url", "field_label": "官网", "type": "url", "required": false},
        {"field_key": "company_achievement", "field_label": "公司成就", "type": "long_text", "required": false, "deprecated": true, "note": "v3 使用 company_achievements"}
      ]
    },
    {
      "group_key": "team",
      "group_label": "团队与融资",
      "fields": [
        {"field_key": "founder_name", "field_label": "创始人", "type": "text"},
        {"field_key": "founder_edu", "field_label": "学历背景", "type": "text"},
        {"field_key": "founder_bg", "field_label": "职业背景", "type": "long_text"},
        {"field_key": "founder_achievement", "field_label": "关键成就", "type": "long_text"},
        {"field_key": "team_size", "field_label": "团队规模", "type": "text"},
        {"field_key": "team_highlight", "field_label": "团队亮点", "type": "long_text"},
        {"field_key": "funding_info", "field_label": "融资信息", "type": "long_text"}
      ]
    },
    {
      "group_key": "product",
      "group_label": "产品",
      "fields": [
        {"field_key": "main_product_name", "field_label": "主产品名", "type": "text"},
        {"field_key": "main_product_def", "field_label": "产品定义", "type": "long_text"},
        {"field_key": "main_product_highlight", "field_label": "亮点功能", "type": "long_text"},
        {"field_key": "main_product_achievement", "field_label": "产品成绩", "type": "long_text"},
        {"field_key": "other_products", "field_label": "其他产品", "type": "long_text", "deprecated": true},
        {"field_key": "tech_stack", "field_label": "技术栈", "type": "long_text", "required": false, "deprecated": true, "note": "v3 使用 product_tech_stack"}
      ]
    },
    {
      "group_key": "business",
      "group_label": "商业模式",
      "fields": [
        {"field_key": "revenue_model", "field_label": "盈利方式", "type": "long_text"},
        {"field_key": "gtm_strategy", "field_label": "GTM 与增长策略", "type": "long_text"},
        {"field_key": "cold_start", "field_label": "冷启动策略", "type": "long_text", "deprecated": true},
        {"field_key": "customer_segment", "field_label": "客户细分", "type": "text"},
        {"field_key": "growth_flywheel", "field_label": "增长飞轮", "type": "long_text"},
        {"field_key": "pricing_model", "field_label": "定价模型", "type": "text"},
        {"field_key": "inference_cost_exposure", "field_label": "推理成本敞口", "type": "text"},
        {"field_key": "company_revenue", "field_label": "公司营收（v1）", "type": "text", "required": false, "deprecated": true},
        {"field_key": "company_profit", "field_label": "公司利润（v1）", "type": "text", "required": false, "deprecated": true},
        {"field_key": "revenue_metrics", "field_label": "营收指标", "type": "text", "required": false},
        {"field_key": "growth_metrics", "field_label": "增长指标", "type": "text", "required": false},
        {"field_key": "regional_markets", "field_label": "分地区市场", "type": "long_text", "required": false}
      ]
    },
    {
      "group_key": "operating_metrics",
      "group_label": "运营指标",
      "fields": [
        {"field_key": "tam", "field_label": "TAM 总可服务市场", "type": "text", "required": false},
        {"field_key": "sam", "field_label": "SAM 可服务市场", "type": "text", "required": false},
        {"field_key": "som", "field_label": "SOM 可获得市场", "type": "text", "required": false},
        {"field_key": "market_cagr", "field_label": "市场复合增长率", "type": "number", "required": false},
        {"field_key": "arr", "field_label": "ARR", "type": "text", "required": false},
        {"field_key": "mrr", "field_label": "MRR", "type": "text", "required": false},
        {"field_key": "registered_users", "field_label": "注册用户", "type": "text", "required": false},
        {"field_key": "active_users", "field_label": "活跃用户", "type": "text", "required": false},
        {"field_key": "paying_users", "field_label": "付费用户", "type": "text", "required": false},
        {"field_key": "retention_rate", "field_label": "留存率", "type": "number", "required": false},
        {"field_key": "churn_rate", "field_label": "流失率", "type": "text", "required": false},
        {"field_key": "cac", "field_label": "CAC 获客成本", "type": "number", "required": false},
        {"field_key": "ltv", "field_label": "LTV 生命周期价值", "type": "number", "required": false},
        {"field_key": "ltv_cac_ratio", "field_label": "LTV/CAC", "type": "number", "required": false},
        {"field_key": "gross_margin", "field_label": "毛利率", "type": "text", "required": false},
        {"field_key": "burn_rate", "field_label": "Burn rate", "type": "text", "required": false},
        {"field_key": "runway_months", "field_label": "Runway 月数", "type": "text", "required": false},
        {"field_key": "market_size_source_note", "field_label": "市场规模来源说明", "type": "long_text", "required": false}
      ]
    },
    {
      "group_key": "competition",
      "group_label": "竞争格局",
      "fields": [
        {"field_key": "moat", "field_label": "竞争壁垒", "type": "long_text"},
        {"field_key": "ecosystem_niche", "field_label": "生态位分析", "type": "long_text"},
        {"field_key": "ecosystem_positioning", "field_label": "生态位一句话", "type": "long_text", "required": false},
        {"field_key": "differentiation_strategy", "field_label": "错位竞争策略", "type": "long_text", "required": false, "deprecated": true},
        {"field_key": "cost_advantage", "field_label": "成本优势", "type": "long_text", "required": false},
        {"field_key": "technical_barrier", "field_label": "技术壁垒", "type": "long_text", "required": false},
        {"field_key": "switching_cost", "field_label": "迁移成本", "type": "long_text", "required": false},
        {"field_key": "competitors", "field_label": "竞品", "type": "long_text"},
        {"field_key": "competitors_summary", "field_label": "竞对Top3摘要", "type": "long_text", "required": false},
        {"field_key": "score_defensibility", "field_label": "壁垒评分", "type": "number", "min": 0, "max": 10},
        {"field_key": "score_incumbent_attention", "field_label": "巨头关注度评分", "type": "number", "min": 0, "max": 10},
        {"field_key": "score_value_capture", "field_label": "价值截留评分", "type": "number", "min": 0, "max": 10},
        {"field_key": "stack_layer", "field_label": "技术栈层级", "type": "enum", "values": ["infrastructure", "foundation_model", "middleware", "vertical_app", "distribution"]},
        {"field_key": "funding_stage_score", "field_label": "融资阶段评分", "type": "number", "min": 0, "max": 10},
        {"field_key": "ai_model_dependency", "field_label": "AI模型依赖度", "type": "enum", "values": ["none", "api_dependent", "fine_tuned", "multi_model", "self_trained"]},
        {"field_key": "workflow_integration_level", "field_label": "工作流集成层级", "type": "enum", "values": ["standalone", "api_connected", "platform_plugin", "workflow_embedded", "infrastructure"]},
        {"field_key": "data_flywheel", "field_label": "数据飞轮", "type": "enum", "values": ["none", "weak", "partial", "strong", "dominant"]},
        {"field_key": "proprietary_data_asset", "field_label": "专有数据资产", "type": "enum", "values": ["none", "public_only", "yes_supplementary", "yes_core", "yes_defensible"]},
        {"field_key": "incumbent_direct_competitor", "field_label": "巨头直接竞争", "type": "enum", "values": ["none", "adjacent", "indirect", "potential", "direct"]},
        {"field_key": "customer_segment_type", "field_label": "客户细分类型", "type": "enum", "values": ["b2c", "b2b_smb", "b2b_enterprise", "b2d", "b2g"]}
      ]
    },
    {
      "group_key": "card_ready_splits",
      "group_label": "卡片拆分字段",
      "fields": [
        {"field_key": "ideal_customer_profile", "field_label": "理想客户画像", "type": "long_text", "required": false},
        {"field_key": "customer_segment_primary", "field_label": "主要客户细分", "type": "long_text", "required": false},
        {"field_key": "customer_segment_secondary", "field_label": "次要客户细分", "type": "long_text", "required": false},
        {"field_key": "growth_strategy", "field_label": "增长策略", "type": "long_text", "required": false},
        {"field_key": "gtm_motion", "field_label": "GTM 打法", "type": "long_text", "required": false, "deprecated": true}
      ]
    },
    {
      "group_key": "summary",
      "group_label": "总结",
      "fields": [
        {"field_key": "market_opportunity", "field_label": "赛道机会", "type": "long_text"},
        {"field_key": "data_confidence", "field_label": "数据可信度", "type": "text"},
        {"field_key": "timeline_events", "field_label": "发展时间线", "type": "json_text"}
      ]
    },
    {
      "group_key": "market",
      "group_label": "市场规模（v3）",
      "fields": [
        {"field_key": "market_landscape_summary", "field_label": "赛道市场格局一句话", "type": "long_text", "required": true},
        {"field_key": "market_landscape_top_players", "field_label": "Top玩家列表", "type": "json_text", "required": false},
        {"field_key": "market_size_value", "field_label": "市场规模数值", "type": "number", "required": false},
        {"field_key": "market_size_currency", "field_label": "市场规模币种", "type": "text", "required": false},
        {"field_key": "market_size_year", "field_label": "市场规模口径年份", "type": "number", "required": false},
        {"field_key": "tam_value", "field_label": "TAM 数值", "type": "number", "required": false},
        {"field_key": "tam_currency", "field_label": "TAM 币种", "type": "text", "required": false},
        {"field_key": "tam_year", "field_label": "TAM 口径年份", "type": "number", "required": false}
      ]
    },
    {
      "group_key": "company_profile",
      "group_label": "公司概况（v3）",
      "fields": [
        {"field_key": "founded_date", "field_label": "成立时间", "type": "text", "required": false},
        {"field_key": "core_business", "field_label": "主营业务", "type": "long_text", "required": true},
        {"field_key": "core_competency", "field_label": "核心竞争优势", "type": "long_text", "required": false},
        {"field_key": "funding_rounds", "field_label": "融资轮次（结构化）", "type": "json_text", "required": false},
        {"field_key": "company_achievements", "field_label": "公司成就里程碑", "type": "long_text", "required": false},
        {"field_key": "industry_positioning", "field_label": "行业定位语", "type": "text", "required": false}
      ]
    },
    {
      "group_key": "product_v3",
      "group_label": "主产品（v3）",
      "fields": [
        {"field_key": "product_pain_points", "field_label": "针对痛点", "type": "json_text", "required": false},
        {"field_key": "product_core_features", "field_label": "核心功能", "type": "json_text", "required": false},
        {"field_key": "product_usage_playbook", "field_label": "核心用法玩法", "type": "long_text", "required": false},
        {"field_key": "product_tech_stack", "field_label": "技术栈", "type": "long_text", "required": false},
        {"field_key": "regional_market_focus", "field_label": "地区市场", "type": "json_text", "required": false},
        {"field_key": "mau", "field_label": "月活跃用户", "type": "number", "required": false},
        {"field_key": "mau_as_of", "field_label": "MAU 统计周期", "type": "text", "required": false},
        {"field_key": "retention_definition", "field_label": "留存率口径说明", "type": "text", "required": false},
        {"field_key": "pricing_summary", "field_label": "定价摘要", "type": "long_text", "required": false},
        {"field_key": "pricing_tiers", "field_label": "定价梯度明细", "type": "json_text", "required": false}
      ]
    },
    {
      "group_key": "customer",
      "group_label": "客户证据（v3）",
      "fields": [
        {"field_key": "customer_names", "field_label": "具体客户名称", "type": "json_text", "required": false},
        {"field_key": "customer_selection_reasons", "field_label": "客户选择理由", "type": "long_text", "required": false},
        {"field_key": "customer_choice_evidence", "field_label": "客户选择证据明细", "type": "json_text", "required": false}
      ]
    },
    {
      "group_key": "capability",
      "group_label": "公司能力分析（v3）",
      "fields": [
        {"field_key": "pricing_strategy", "field_label": "定价策略", "type": "long_text", "required": false},
        {"field_key": "ltv_cac_is_benchmark", "field_label": "LTV/CAC 是否为行业均值", "type": "number", "required": false},
        {"field_key": "ltv_cac_benchmark_source", "field_label": "LTV/CAC benchmark 来源", "type": "text", "required": false}
      ]
    },
    {
      "group_key": "gtm_v3",
      "group_label": "增长与GTM（v3）",
      "fields": [
        {"field_key": "acquisition_channels", "field_label": "获客渠道", "type": "json_text", "required": false}
      ]
    },
    {
      "group_key": "competition_v3",
      "group_label": "竞争态势（v3）",
      "fields": [
        {"field_key": "competitors_top3", "field_label": "Top3 公司简介（结构化）", "type": "json_text", "required": true},
        {"field_key": "competitive_position", "field_label": "被研公司在竞争中的位置", "type": "long_text", "required": true},
        {"field_key": "differentiated_opportunity", "field_label": "错位竞争机会", "type": "long_text", "required": false},
        {"field_key": "competitive_advantages", "field_label": "竞争优势摘要", "type": "long_text", "required": false}
      ]
    },
    {
      "group_key": "hook",
      "group_label": "传播钩子",
      "fields": [
        {"field_key": "hook_paragraph_1", "field_label": "钩子段落1", "type": "long_text"},
        {"field_key": "hook_paragraph_2", "field_label": "钩子段落2", "type": "long_text"},
        {"field_key": "hook_paragraph_3", "field_label": "钩子段落3", "type": "long_text"}
      ]
    }
  ]
}
