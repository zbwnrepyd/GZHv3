{
  "version": "1.0",
  "description": "N:N field-to-acquisition-method mapping. Every field in contracts/fields.json is mapped to one or more acquisition methods. Used by field resolution governance to determine which pipeline stages produce each field.",
  "acquisition_methods": {
    "L0_llm": "Extracted by L0 quality gate LLM prompt (prompts/layer0*.md)",
    "L1_llm": "Extracted by L1 competitive matrix LLM prompt (prompts/layer1*.md)",
    "L2_llm": "Extracted by L2 business canvas LLM prompt (prompts/layer2*.md)",
    "L3_llm": "Extracted by L3 unified or group LLM prompts (prompts/layer3*.md)",
    "enum_llm": "Extracted by L3 enumerated field groups A/B/C (prompts/layer3-group-*.md)",
    "derivation": "Derived from other fields via derivation_pass.py or derived_field_resolver.py",
    "scoring_inference": "Inferred by scoring_inference.py v2 scoring enums",
    "formula": "Computed by formula in field_resolver.py or competitive_scoring.py",
    "industry_benchmark": "Fallback value from industry_benchmarks.py",
    "market_intelligence": "Produced by market_intelligence CLI module",
    "hook_writer": "Generated by hook_writer.py or writing_pass.py",
    "targeted_search": "Searched via targeted_search.py in field resolution governance",
    "unavailable_classifier": "Defaulted to unavailable by unavailable_classifier.py",
    "supplemental_adapter": "Collected by supplementary adapters (GitHub, YouTube, ProductHunt, etc.)",
    "rule_layer": "From field_rules.py rule-based extraction (pricing page scraping, keyword matching)"
  },
  "categories": {
    "official_fact": "Direct facts from web search + LLM (Tier 1)",
    "market_model": "Market size estimates (Tier 1, status=proxy)",
    "private_metric": "Private operating metrics (Tier 2-3)",
    "enum_extraction": "Enumerated/scoring fields (Tier 1)",
    "derived_field": "Fields derived by formulas or LLM from other fields",
    "scoring_field": "v2 scoring inference enums (internal use only)",
    "llm_generated": "Hook paragraphs generated by LLM"
  },
